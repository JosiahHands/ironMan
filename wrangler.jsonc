// Cloudflare deploy settings: "npx wrangler deploy" publishes the site.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironman", // must match the Worker name in the Cloudflare dashboard
  "compatibility_date": "2026-11-01",

  // Compile the TypeScript before every deploy (and before "wrangler dev")
  "build": {
    "command": "npm run build"
  },

  // A tiny Worker that serves videos in pieces so Safari-engine browsers can play them
  "main": "worker/index.ts",

  // Everything in web/ is served as static files, except what web/.assetsignore lists
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    // only video requests go through the Worker first; everything else skips it
    "run_worker_first": ["/media/videos/*"]
  }
}
